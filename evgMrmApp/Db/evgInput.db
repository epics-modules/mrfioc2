record(bo, "$(P)EnaIrq-Sel") {
  field(DESC, "Enable External Input IRQ")
  field(ASG,  "$(ASGPROTECTED=protected)")
  field(DTYP, "Obj Prop bool")
  field(OUT , "@OBJ=$(OBJ), PROP=IRQ")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(OMSL, "closed_loop")
    # see evgMrm.db
  field(DOL,  "$(PP=$(SYS){$(D)})PpsInp$(CONT=)-MbbiDir_.B$(Num) CP")
  field(FLNK, "$(P)EnaIrq-RB")
  info(autosaveFields_pass0, "VAL")
}

record(bi, "$(P)EnaIrq-RB") {
  field(DESC, "Enable External Input IRQ")
  field(DTYP, "Obj Prop bool")
  field(INP , "@OBJ=$(OBJ), PROP=IRQ")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
}

# Maps physical input to sequence mask-lines 0-3 (4-bit bitmask, B0..B3 = lines 0..3).
# The driver rejects values > 15.
record(mbboDirect, "$(P)FPMask-Sel") {
  field(DESC, "FPxMask: seq mask-lines 0-3")
  field(ASG,  "$(ASGPROTECTED=protected)")
  field(DTYP, "Obj Prop uint32")
  field(OUT , "@OBJ=$(OBJ), PROP=FPMASK")
  field(NOBT, "4")
  field(PINI, "YES")
  field(FLNK, "$(P)FPMask-RB")
  info(autosaveFields_pass0, "VAL")
}
record(mbbiDirect, "$(P)FPMask-RB") {
  field(DESC, "FPxMask: seq mask-lines 0-3")
  field(DTYP, "Obj Prop uint32")
  field(INP , "@OBJ=$(OBJ), PROP=FPMASK")
  field(NOBT, "4")
}

# Maps physical input to sequence enable-lines 1-3. Register bit 24 (enable
# line 0) is shared with EVG_EXT_INP_IRQ_ENA and owned by EnaIrq-Sel/PPS, so it
# is shifted out: B0..B2 = enable lines 1..3 (RVAL = VAL << 1 is always even).
# The driver rejects values that would set bit 0 or exceed lines 1-3.
record(mbboDirect, "$(P)FPEna-Sel") {
  field(DESC, "FPxEna: seq enable-lines 1-3 (B0=line1)")
  field(ASG,  "$(ASGPROTECTED=protected)")
  field(DTYP, "Obj Prop uint32")
  field(OUT , "@OBJ=$(OBJ), PROP=FPENA")
  field(NOBT, "3")
  field(SHFT, "1")
  field(PINI, "YES")
  field(FLNK, "$(P)FPEna-RB")
  info(autosaveFields_pass0, "VAL")
}
record(mbbiDirect, "$(P)FPEna-RB") {
  field(DESC, "FPxEna: seq enable-lines 1-3 (B0=line1)")
  field(DTYP, "Obj Prop uint32")
  field(INP , "@OBJ=$(OBJ), PROP=FPENA")
  field(NOBT, "3")
  field(SHFT, "1")
}

record(bo, "$(P)EnaMxcr-Sel") {
  field(DESC, "Enable Hardware Mxc Reset")
  field(ASG,  "$(ASGPROTECTED=protected)")
  field(DTYP, "Obj Prop bool")
  field(OUT , "@OBJ=$(OBJ), PROP=Hw Reset MXC")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(FLNK, "$(P)EnaMxcr-RB")
  info(autosaveFields_pass0, "VAL")
}

record(bi, "$(P)EnaMxcr-RB") {
  field(DESC, "Enable Hardware Mxc Reset")
  field(DTYP, "Obj Prop bool")
  field(INP , "@OBJ=$(OBJ), PROP=Hw Reset MXC")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
}
